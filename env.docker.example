# Sao chép thành .env.local khi backend Docker trong ship-app-api (APP_URL=http://localhost:8080).

# Origin backend — khớp APP_URL Laravel (không có /api). Vite dev: proxy /api → địa chỉ này.
VITE_API_ORIGIN=http://localhost:8080

# php artisan serve (:8000):
# VITE_API_ORIGIN=http://localhost:8000

# Ghi đè tuyệt đối (hiếm khi):
# VITE_API_BASE_URL=http://localhost:8080/api

VITE_AUTO_LOGIN=false
