# API Configuration
VITE_API_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=/api
# Optional axios timeout in ms (default: 30000)
# VITE_API_TIMEOUT_MS=30000

# true = axios 401 thử POST /auth/refresh (cần refresh token). Bỏ qua hoặc false = logout ngay.
# VITE_AUTH_REFRESH_ENABLED=true

# Forgot password endpoints (backend pending)
VITE_AUTH_FORGOT_PASSWORD_SEND_ENABLED=true
VITE_AUTH_FORGOT_PASSWORD_VERIFY_ENABLED=true
# VITE_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
# VITE_AUTH_FORGOT_PASSWORD_VERIFY_PATH=/auth/reset-password

# Chat assistant (backend trả 501 khi tắt — bật khi có API chat thật)
VITE_CHAT_ENABLED=false

# Đăng ký public — bật khi Laravel có POST /api/auth/register (mặc định tắt).
# VITE_REGISTER_ENABLED=true

# Feature flags — keep incomplete workflows hidden until backend support is deployed.
# VITE_BILLING_ENABLED=true
# VITE_RECONCILIATION_ACTIONS_ENABLED=true
# VITE_USER_PERMISSIONS_ENABLED=false
# VITE_EINVOICE_CQT_ENABLED=true

# Development Settings — production: giữ false.
VITE_AUTO_LOGIN=false
VITE_TEST_ACCOUNTS=false

# Demo credentials — CHỈ dùng local/dev; không dùng trên production.
# VITE_DEMO_EMAIL=admin@example.com
# VITE_DEMO_PASSWORD=changeme

# NHTSA vPIC (make/model catalog for vehicle form). Dev: omit to use Vite `/vpic` proxy.
# VITE_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov

# App Configuration
VITE_APP_NAME=Ship ERP
VITE_APP_VERSION=1.0.0
