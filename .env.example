# API Configuration
# Backend origin (APP_URL Laravel), API prefix is handled as /api in frontend config
VITE_API_ORIGIN=http://localhost:8080

# Optional explicit API base URL override (normally not needed)
# VITE_API_BASE_URL=http://localhost:8080/api

# Development Settings
# Enable auto-login in development mode (true/false)
VITE_AUTO_LOGIN=false

# Demo Credentials (for development only)
# These credentials are used for auto-login feature
VITE_DEMO_EMAIL=admin@abctransport.com
VITE_DEMO_PASSWORD=password

# App Configuration
VITE_APP_NAME=Ship ERP
VITE_APP_VERSION=1.0.0
