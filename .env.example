# API Configuration
# Ưu tiên dùng ORIGIN (không /api) để đồng bộ với backend APP_URL
VITE_API_ORIGIN=http://localhost:8080

# Ghi đè tuyệt đối endpoint (tuỳ chọn, hiếm khi cần)
# VITE_API_BASE_URL=http://localhost:8080/api

# Legacy alias (tuỳ chọn)
# VITE_PROXY_TARGET=http://localhost:8080

# Forgot password endpoints (backend pending)
VITE_AUTH_FORGOT_PASSWORD_SEND_ENABLED=true
VITE_AUTH_FORGOT_PASSWORD_VERIFY_ENABLED=true
# VITE_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
# VITE_AUTH_FORGOT_PASSWORD_VERIFY_PATH=/auth/reset-password

# Development Settings
VITE_AUTO_LOGIN=true
VITE_TEST_ACCOUNTS=true

# Demo Credentials (for development only)
VITE_DEMO_EMAIL=admin@abctransport.com
VITE_DEMO_PASSWORD=password

# App Configuration
VITE_APP_NAME=Ship ERP
VITE_APP_VERSION=1.0.0
